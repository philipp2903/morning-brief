#!/usr/bin/env python
# Morning Brief - a curated daily digest for Kindle.
#
# Pulls headlines from The Economist, NYT, The Guardian, Tagesspiegel,
# Sportschau, Kicker, ESPN, The Athletic and Quanta, asks Claude to fill each
# source's quota (see READER_PROFILE) with its best available pieces,
# downloads only those, and binds them into one periodical.

import calendar
import datetime
import json
import os
import re
import subprocess
import time
import urllib.error
import urllib.parse
import urllib.request

from calibre.web.feeds import Feed
from calibre.web.feeds.news import BasicNewsRecipe

# ---------------------------------------------------------------------------
# CONFIGURATION
# ---------------------------------------------------------------------------

# What "relevant" means. Edit freely - this is the steering wheel.
READER_PROFILE = """
Berlin-based founder and consultant. Runs a small consulting practice focused
on AI adoption and operating cadence in enterprises, with clients in Germany
and internationally. Reads The Economist regularly and wants analysis over
recap: pieces that explain a mechanism or a consequence, not just report a
number or an event.

Overall priority, highest first, when judging how much a category deserves
strong picks versus a weaker slot going unfilled: (1) economics and
business, (2) sport, (3) Berlin, (4) US politics and foreign affairs,
(5) German national politics. This is about emphasis and how strict to be
within a category, not a quota - the per-source maximums below still cap
each source regardless of where its category sits in this list, and German
politics being lowest is exactly why it has no dedicated feed of its own:
only cover it when it surfaces incidentally through another source's own
candidates (e.g. a Tagesspiegel piece that is really about the Berlin
election, or an Economist/NYT piece on German politics specifically).

Reader is a paying subscriber to The Economist, The New York Times (which
covers The Athletic), and Tagesspiegel Plus - subscription content from
those three is fully accessible and should be used freely, not treated as
harder to reach than the free sources. The Guardian and Quanta are the only
free sources left in the brief; they exist to fill gaps the paid sources
don't cover, not to compete with them - when a paid source and a free
source both have a decent piece on the same story, prefer the paid one.

Never ship a snippet or a paywall teaser as if it were the full article -
if a source only gives a partial preview, it does not belong in the brief
at all, regardless of how interesting the headline is.

German-language sources (Tagesspiegel, Sportschau, Kicker) are for German
and Berlin-specific stories. Do not use them as a backdoor for US or other
non-German wire stories that happen to be translated/covered in German -
those belong to the NYT/Economist/Guardian slots instead, in English.

The brief draws from eight sources, each with a fixed role and a maximum
slot count. Fill each source's slots with its best available pieces for
that role - it is fine to come in under a source's maximum on a slow day,
but do not pad a weak slot, and do not give one source more than its
stated maximum even if another source is short that day.

1. THE ECONOMIST - up to 7 slots. International economics and business
   analysis, plus its Leaders and By Invitation opinion pieces: this is the
   exact voice and altitude the rest of the brief is calibrated against, so
   hold every other source's "analysis over recap" pieces to this bar.

2. THE NEW YORK TIMES - up to 6 slots. US politics and business; foreign
   affairs the US is driving; plus its Opinion section. Prefer consequence
   over process: what a decision changes, not who said what about it.

3. THE GUARDIAN - up to 4 slots (free, supplementary). International
   business and foreign affairs, only for stories genuinely not already
   well covered by the paid sources' picks.

4. TAGESSPIEGEL - up to 8 slots. The Berlin desk of the brief, and the
   fullest slot count outside The Economist for exactly that reason: city
   politics and elections, transport, housing, schools, business and
   anything affecting Treptow-Koepenick and Friedrichshagen specifically,
   plus its Meinung (opinion) section for Berlin/German commentary.
   Strongly prefer hard, current news (an election, a corruption inquiry,
   a transit disruption, a policy fight) over soft human-interest or
   lifestyle features (travel diaries, personal essays, culture-page
   filler) - a quiet news day with one real Berlin story beats five soft
   features every time.

5. SPORTSCHAU - up to 3 slots. German sport generally (not just football).
   Only when the story is genuinely interesting: a manager sacked, a club
   in financial trouble, a title race turning, a notable transfer. Never
   routine match reports, tables or fixture previews.

6. KICKER - up to 5 slots. The primary German football source - Bundesliga
   and football first. About 80% of this source's kept slots should be
   football/Bundesliga; the rest can be another German sport story genuinely
   worth a slot (this feed carries all sports, not just football, so be
   selective). Same spirit as Sportschau - skip routine match reports,
   tables and fixture previews - but read "genuinely interesting" a little
   wider here, since this is the primary football source with room for
   several picks a day, not just the single standout story: a confirmed
   transfer or contract situation, a player's international retirement, a
   federation/league policy or structural decision (e.g. a DFB ruling, a
   league-format reform), or a club dispute all count, not only sackings
   and title races.

7. THE ATHLETIC - up to 7 slots. US sport (NFL, NBA, MLB), in-depth:
   analysis and reported features, the sport-desk equivalent of the
   long-read bar this brief holds international sources to elsewhere.
   Prefer this over ESPN when a story has real depth to it.

8. ESPN - up to 2 slots. US sport (NFL, NBA, MLB) quick news: scores,
   trades, injuries when they actually matter and The Athletic hasn't
   already covered them in more depth. Same bar as Sportschau/Kicker:
   genuinely interesting, not routine game recaps or previews.

Outside the eight numbered sources above:

QUANTA MAGAZINE - up to 2 slots (free). Properly substantial science or
mathematics background reads.

Never select two articles covering the same story from different outlets -
prefer whichever single piece explains it best.

Not wanted at all: celebrity and royals, lifestyle and wellness, horoscopes,
listicles, crime reporting without wider significance, and repeat coverage
of a story already carried on a previous day.
"""

# Sum of the per-source maximums above (7+6+4+8+3+5+7+2+2).
MAX_ARTICLES = 44

# Enforced in code as a hard cap after Claude's selection, not just left to
# the prompt - keys must match the "<Source> - <Section>" feed-title prefix
# used in `feeds` below.
SOURCE_SLOT_LIMITS = {
    "Economist": 7,
    "NYT": 6,
    "Guardian": 4,
    "Tagesspiegel": 8,
    "Sportschau": 3,
    "Kicker": 5,
    "Athletic": 7,
    "ESPN": 2,
    "Quanta": 2,
}

# If Claude cannot be reached, keep this many articles per feed instead.
# Low, because there are now ~5 feeds per source - the fallback is a rough
# "something is better than nothing" safety net, not a curated substitute.
FALLBACK_PER_FEED = 1

# Sonnet gives better editorial judgement; swap to
# "claude-haiku-4-5-20251001" if you want it cheaper still.
CLAUDE_MODEL = os.environ.get("CLAUDE_MODEL", "claude-sonnet-5")

# Path to the history of already-delivered articles. Optional: leave the
# environment variable unset and the brief simply stops deduplicating.
# Resolved to an absolute path so it lands in the same place regardless of
# what directory calibre's recipe execution happens to run from.
_sent_urls_file = os.environ.get("SENT_URLS_FILE", "")
SENT_URLS_FILE = os.path.abspath(_sent_urls_file) if _sent_urls_file else ""
SENT_WINDOW_DAYS = 14

# Build identifier, stamped into the periodical so a given brief can be
# traced back to the recipe version that produced it. Set by the workflow;
# falls back to something recognisable for local runs.
RECIPE_VERSION = os.environ.get("RECIPE_VERSION", "local-dev").strip() or "local-dev"

# All article fetching (except The Guardian, which already has clean body
# text from its own API) goes through fetch_via_chrome.py: a real,
# persistently-running Chrome instance attached over CDP - not a freshly
# launched automation profile, which both NYT (DataDome) and The Economist
# (Cloudflare) block on sight, since Playwright/Selenium set a
# navigator.webdriver flag those vendors check for specifically. That
# script also runs Mozilla's Readability.js (Firefox Reader View's own
# extraction library) against the live page and returns the cleaned
# article, replacing Calibre's own auto_cleanup (see below) everywhere,
# not just on the two bot-walled sources - a real build showed Calibre's
# older readability port either throwing outright on modern JS-framework
# pages (silently falling back to the *raw* page: cookie-vendor lists,
# sitemaps, nav trees) or failing to separate article body from chrome.
# If CHROME_FETCH_PYTHON/CHROME_FETCH_SCRIPT are unset, everything falls
# back to Calibre's normal fetcher + auto_cleanup instead.
CHROME_FETCH_PYTHON = os.environ.get("CHROME_FETCH_PYTHON", "")
CHROME_FETCH_SCRIPT = os.environ.get("CHROME_FETCH_SCRIPT", "")

# Phrases that show up on bot-blocked or paywalled pages instead of real
# article text. If a downloaded article's content matches one of these (or
# is simply too short to be an article), it is dropped rather than shipped.
#
# NOTE: plain "please enable javascript"/"please enable js" used to be here
# and caused real false positives - that exact phrase is standard
# <noscript> boilerplate on nearly every modern JS-framework site (confirmed
# on a genuinely free, manually-verified Handelsblatt article, which is how
# this was caught), not a bot-block signal by itself. Keep markers specific
# enough to actually distinguish a block page from ordinary noscript text.
BROKEN_CONTENT_MARKERS = (
    # NYT/generic DataDome-style block pages actually say "enable JS and
    # disable any ad blocker" - "disable any ad blocker" alone is specific
    # enough to catch it without needing the exact "enable JS" wording too.
    "disable any ad blocker",
    "disable your ad blocker",
    "subscribe to continue reading",
    "you have reached your article limit",
    "access denied",
    "are you a robot",
    "verify you are a human",
    # Tagesspiegel's paywall: the free preview is real but partial, not
    # broken - it still fails the "read the whole thing on Kindle" bar.
    # NOTE: bare "tagesspiegel plus" used to be here and was a real false
    # positive once logged in - Tagesspiegel's own related-links widget
    # mentions "Tagesspiegel Plus (T+)" by product name on plenty of fully
    # unlocked articles too (confirmed directly: a genuinely full 3756-char
    # article got dropped over this exact phrase, deep in a "more from
    # this section" block, nothing to do with that article's own access).
    # MIN_ARTICLE_CHARS plus the more specific markers below still catch a
    # truly locked page.
    "abopflichtiger inhalt",
    "jetzt abonnieren",
    # NYT paywall hit when the Chrome session isn't (or is no longer) logged
    # in - same "partial preview, not the whole article" logic.
    "want all of the times? subscribe",
    "log in to continue reading",
)
# Measured against the *extracted* article body (what auto_cleanup would
# actually ship), not the raw page - a raw page is always >500 chars of
# nav/footer/cookie-banner chrome regardless of how little real article
# text it contains, which is how a one-paragraph paywall teaser slipped
# through the first version of this check.
MIN_ARTICLE_CHARS = 500

SELECTION_SYSTEM_PROMPT = """You are the editor of a personal morning \
newspaper. You are given today's candidate articles (each labelled with its \
source) and a profile of the single reader that states each source's role \
and maximum slot count. Fill each source's slots with its best available \
candidates for that source's stated role.

Rules:
- Each source's slot count is a MAXIMUM, not a target: it is fine to use
  fewer of a source's slots on a slow day, but never more than its stated
  maximum, and never reassign one source's unused slots to another source.
- Favour substance over volume. Prefer one strong analysis over three thin
  updates on the same event.
- Never select two articles covering the same story from different outlets.
- Answer with JSON only, no prose and no code fences, in exactly this shape:
  {"keep": [3, 11, 24]}
  where the numbers are the candidate ids you are keeping, most important
  first."""


class MorningBrief(BasicNewsRecipe):
    title = "Morning Brief"
    description = (
        "A curated selection from The Economist, NYT, The Guardian, "
        "Tagesspiegel, Sportschau, Kicker, ESPN, The Athletic and Quanta"
    )
    __author__ = "Philipp Schett"
    publication_type = "newspaper"
    language = "de"
    encoding = "utf-8"

    # Two days rather than one, so that long reads published yesterday
    # afternoon are still eligible. The sent-article history below stops the
    # wider window causing repeats.
    oldest_article = 2
    max_articles_per_feed = 20

    # NYT returns 403 Forbidden to plain HTTP fetches of article pages (RSS
    # itself is unaffected). Use the QtWebEngine-based fetcher instead of
    # calibre's default mechanize one to get past that.
    browser_type = "webengine"
    # Calibre's default (12) is fine for lightweight HTTP downloads, but
    # every article here costs a real Chrome page load + JS injection now.
    # A run that hung for over an hour (later cancelled) coincided with the
    # machine being under real memory pressure (~65MB free at the time) -
    # 12 of those firing concurrently through one shared Chrome instance is
    # a plausible way to get there. Much lower concurrency, deliberately.
    simultaneous_downloads = 3

    no_stylesheets = True
    remove_javascript = True
    use_embedded_content = False
    # Defensive: strip any inline sizing/positioning that survives from a
    # source site's markup (no_stylesheets only drops external <link
    # rel=stylesheet>, not inline style=/width=/height= attributes).
    # Calibre's own upstream financial_times.recipe does the same for
    # exactly this reason.
    remove_attributes = ["style", "width", "height"]
    # 47 possible articles across 10 sources with real embedded photos adds
    # up fast (one earlier 22-article build was already ~19MB) - Send to
    # Kindle's own limits (50MB email, and a documented tendency to fail
    # server-side conversion on large/complex files with a generic E999
    # error) make it worth capping images rather than shipping them at
    # full source resolution.
    compress_news_images = True
    compress_news_images_max_size = 60  # KB
    scale_news_images = (800, 800)
    # auto_cleanup itself is set dynamically in __init__ (off when the
    # Chrome+Readability.js path is configured, since that already returns
    # clean content - see there for why). auto_cleanup_keep only matters
    # for the fallback case where auto_cleanup does run: force ZEIT's and
    # Tagesspiegel's hero-image containers to survive, since auto_cleanup's
    # own readability scoring otherwise drops anything outside the
    # paragraph flow it judges to be "the article".
    auto_cleanup_keep = (
        '//header[contains(@class,"article-header")]'
        '|//header[contains(@class,"Bo")]'
    )
    remove_empty_feeds = True
    ignore_duplicate_articles = {"title", "url"}
    timefmt = " [%a, %d %B %Y] - " + RECIPE_VERSION

    feeds = [
        # Espresso's own RSS (and the bare /rss) are Cloudflare-blocked even
        # for feed discovery, unlike these regular section feeds - articles
        # from any of these still route through the Chrome CDP fetcher via
        # CHROME_FETCH_DOMAINS for the actual full-text download.
        ("Economist - Finance & Economics", "https://www.economist.com/finance-and-economics/rss.xml"),
        ("Economist - Business", "https://www.economist.com/business/rss.xml"),
        ("Economist - Europe", "https://www.economist.com/europe/rss.xml"),
        ("Economist - International", "https://www.economist.com/international/rss.xml"),
        # Opinion: the weekly leaders and guest-contributor pieces.
        ("Economist - Leaders", "https://www.economist.com/leaders/rss.xml"),
        ("Economist - By Invitation", "https://www.economist.com/by-invitation/rss.xml"),
        ("NYT - Business", "https://rss.nytimes.com/services/xml/rss/nyt/Business.xml"),
        ("NYT - Economy", "https://rss.nytimes.com/services/xml/rss/nyt/Economy.xml"),
        ("NYT - Politics", "https://rss.nytimes.com/services/xml/rss/nyt/Politics.xml"),
        ("NYT - World", "https://rss.nytimes.com/services/xml/rss/nyt/World.xml"),
        ("NYT - Technology", "https://rss.nytimes.com/services/xml/rss/nyt/Technology.xml"),
        # Opinion, per the reader's own request for more of it. HomePage was
        # dropped: it's just a mix of the other NYT section feeds already
        # covered individually, adding volume without a distinct role.
        ("NYT - Opinion", "https://rss.nytimes.com/services/xml/rss/nyt/Opinion.xml"),
        # Berlin news, and Berlin-relevant opinion. "Home" used to be a feed
        # here too, but it mixes in general entertainment/culture wire
        # content (confirmed directly: a US politics story about Erika
        # Kirk's statement showed up through it) that has nothing to do
        # with Berlin - dropped in favour of just the two feeds that are
        # actually on-topic.
        ("Tagesspiegel - Berlin", "https://www.tagesspiegel.de/contentexport/feed/berlin"),
        ("Tagesspiegel - Meinung", "https://www.tagesspiegel.de/contentexport/feed/meinung"),
        ("Sportschau - Alle Sportarten", "https://www.sportschau.de/index~rss2.xml"),
        # Kicker's own site is Cloudflare/DataDome-walled like NYT/Economist
        # (routes through the Chrome CDP fetcher, logged-in session, same as
        # those two), but this newsfeed.kicker.de subdomain used for feed
        # discovery is not. It's an all-sport firehose (cycling, basketball,
        # F1 alongside Bundesliga), not football-only - there's no
        # football-specific feed on kicker.de, so the "mostly football"
        # split is enforced in the selection prompt, not the feed URL.
        ("Kicker - Alle Sportarten", "https://newsfeed.kicker.de/news/aktuell"),
        ("ESPN - NFL", "https://www.espn.com/espn/rss/nfl/news"),
        ("ESPN - NBA", "https://www.espn.com/espn/rss/nba/news"),
        # theathletic.com's own domain sits behind Cloudflare like FT did;
        # The Athletic is owned by NYT and hosted under nytimes.com/athletic/
        # instead, which is why these use that domain - CHROME_FETCH_DOMAINS
        # already covers it, and the NYT login session doubles as Athletic
        # access (NYT All Access includes it).
        ("Athletic - NFL", "https://www.nytimes.com/athletic/rss/nfl/"),
        ("Athletic - NBA", "https://www.nytimes.com/athletic/rss/nba/"),
        ("Athletic - MLB", "https://www.nytimes.com/athletic/rss/mlb/"),
        ("Quanta - Articles", "https://api.quantamagazine.org/feed/"),
    ]

    def __init__(self, *args, **kwargs):
        BasicNewsRecipe.__init__(self, *args, **kwargs)
        # url -> full article HTML, populated by fetch_guardian_candidates.
        # Guardian's own site has no bot-wall, but their API already hands
        # us the full body in the same call that finds the candidates, so
        # there's no reason to fetch each article a second time over HTTP.
        self._guardian_bodies = {}
        # url -> fetched+extracted HTML, shared between the quality-gate
        # pre-check and the real download so each article only costs one
        # Chrome navigation, not two.
        self._chrome_fetch_cache = {}
        # When the Chrome+Readability.js path is configured, it already
        # returns clean extracted content for every article (Guardian
        # excepted, which is clean for a different reason - see above).
        # Running Calibre's own (older, less reliable against modern
        # JS-framework sites - confirmed directly on a real build) auto_
        # cleanup again on top of that would double-process it, which
        # caused unreliable results the one other place this recipe tried
        # it (the quality gate's now-reverted extract_readable_article
        # experiment). Only used as a fallback when Chrome fetching isn't
        # configured at all.
        self.auto_cleanup = not (CHROME_FETCH_PYTHON and CHROME_FETCH_SCRIPT)

    # -- The Guardian (Open Platform API) --------------------------------

    GUARDIAN_SECTIONS = ("world", "business")

    def fetch_guardian_candidates(self):
        api_key = os.environ.get("GUARDIAN_API_KEY", "").strip()
        if not api_key:
            self.log.warn("GUARDIAN_API_KEY is not set; skipping The Guardian.")
            return None

        from_date = (datetime.date.today() - datetime.timedelta(days=self.oldest_article)).isoformat()
        params = {
            "section": "|".join(self.GUARDIAN_SECTIONS),
            "type": "article",
            "order-by": "newest",
            "show-fields": "trailText,body,byline",
            "page-size": "30",
            "from-date": from_date,
            "api-key": api_key,
        }
        url = "https://content.guardianapis.com/search?" + urllib.parse.urlencode(params)
        try:
            with urllib.request.urlopen(url, timeout=30) as response:
                payload = json.load(response)
        except Exception as err:
            self.log.error("Guardian API request failed: %s" % err)
            return None

        # populate_from_preparsed_feed() is calibre's own hook for exactly
        # this - injecting non-RSS article data - and handles the Feed
        # attributes a hand-built Feed() is easy to get wrong (feed2index()
        # needs image_url/width/height/alt, which a naive Feed() lacks),
        # plus age filtering and dedup, the same as the normal RSS path.
        items = []
        for item in payload.get("response", {}).get("results", []):
            fields = item.get("fields", {})
            body = fields.get("body", "")
            article_url = item.get("webUrl", "")
            if not body or not article_url:
                continue
            try:
                timestamp = calendar.timegm(
                    time.strptime(item.get("webPublicationDate", ""), "%Y-%m-%dT%H:%M:%SZ")
                )
            except ValueError:
                timestamp = time.time()
            self._guardian_bodies[article_url] = "<html><body>%s</body></html>" % body
            items.append({
                "id": item.get("id", article_url),
                "title": item.get("webTitle", ""),
                "url": article_url,
                "author": fields.get("byline", ""),
                "description": fields.get("trailText", ""),
                "content": "",
                "timestamp": timestamp,
            })

        feed = Feed(log=self.log)
        feed.populate_from_preparsed_feed(
            "Guardian - World & Business", items,
            oldest_article=self.oldest_article,
            max_articles_per_feed=self.max_articles_per_feed,
        )
        self.log("Guardian API returned %d candidate articles." % len(feed.articles))
        return feed

    # -- Chrome CDP fetch (NYT) -------------------------------------------

    def needs_chrome_fetch(self, url):
        return bool(CHROME_FETCH_PYTHON) and bool(CHROME_FETCH_SCRIPT)

    def fetch_via_chrome(self, url):
        # Cached because fetch_raw_html (the quality-gate pre-check) and
        # preprocess_raw_html (the real download) both want this, and a
        # Chrome navigation + Readability pass isn't cheap - no reason to
        # pay for it twice per article.
        if url in self._chrome_fetch_cache:
            return self._chrome_fetch_cache[url]
        result = subprocess.run(
            [CHROME_FETCH_PYTHON, CHROME_FETCH_SCRIPT, url],
            capture_output=True, timeout=90,
        )
        if result.returncode != 0:
            raise RuntimeError(result.stderr.decode("utf-8", "replace")[:500])
        html = result.stdout.decode("utf-8", "replace")
        if "/athletic/" in url:
            html = self.strip_athletic_nav_chrome(html)
        self._chrome_fetch_cache[url] = html
        return html

    def fetch_raw_html(self, url):
        """Raw HTML for a URL: Guardian uses the body its API already
        handed us; everything else goes through the real-Chrome +
        Readability.js fetcher (or Calibre's normal fetcher if that isn't
        configured)."""
        if url in self._guardian_bodies:
            return self._guardian_bodies[url]
        if self.needs_chrome_fetch(url):
            return self.fetch_via_chrome(url)
        raw = self.index_to_soup(url, raw=True)
        if isinstance(raw, bytes):
            raw = raw.decode("utf-8", "replace")
        return raw

    def preprocess_raw_html(self, raw_html, url):
        if url in self._guardian_bodies:
            return self._guardian_bodies[url]
        # Calibre's own webengine fetch already ran (and, for NYT/
        # Economist, got blocked) by the time this hook fires - throw it
        # away and use the real-Chrome + Readability path instead.
        if self.needs_chrome_fetch(url):
            try:
                return self.fetch_via_chrome(url)
            except Exception as err:
                self.log.warn("Chrome CDP fetch failed for %s: %s" % (url, err))
        return raw_html

    @staticmethod
    def strip_athletic_nav_chrome(raw_html):
        """The Athletic's league-picker nav bar sits in the same container
        as the article body on their Next.js pages, so readability's own
        content-boundary detection can't separate it out - confirmed on a
        real build where 3 Athletic articles alone accounted for ~250 <img>
        tags, all league logos from this one CDN, none of them the actual
        article. Their CSS class names are build-hashed (unstable), so
        match by the stable image source pattern instead.
        """
        if "cdn-league-logos.theathletic.com" not in raw_html:
            return raw_html
        return re.sub(r'<img\b[^>]*cdn-league-logos\.theathletic\.com[^>]*>', "", raw_html)

    # -- images ---------------------------------------------------------

    # After the site-specific fixes (Athletic nav icons, live-blog
    # exclusion) there were still individual articles with 40-65 <img>
    # tags each - not always identifiable noise, sometimes just a
    # legitimately photo-heavy piece (an ESPN "tier every team" article
    # genuinely has ~30 team logos). Rather than keep chasing each site's
    # specific clutter pattern, cap it generally: real reading value is in
    # the first few images (hero + early inline), and this directly bounds
    # file size/complexity regardless of which source causes it.
    MAX_IMAGES_PER_ARTICLE = 8

    def preprocess_html(self, soup):
        # Inline SVGs are essentially always UI chrome (icon sprite sheets
        # with dozens of <symbol> definitions, social-share icons, etc.),
        # never real article content - a real image is an <img>. Confirmed
        # directly: Readability.js pulled a whole ZEIT icon-sprite sheet
        # into "extracted content" because the <symbol> elements carry
        # descriptive <title> text that reads as plausible content.
        for svg in soup.find_all("svg"):
            svg.decompose()

        # NYT-specific boilerplate ("SKIP ADVERTISEMENT") that Readability
        # doesn't exclude - it's a real interactive element on nytimes.com
        # (a skip-link for screen readers), not article content.
        for el in soup.find_all(string=re.compile(r"skip advertisement", re.IGNORECASE)):
            parent = el.parent
            if parent and len(parent.get_text(strip=True)) < 40:
                parent.decompose()

        # Some sites lazy-load images via data-src/data-original, either
        # leaving src empty until JS runs, or (confirmed directly on The
        # Athletic's Next.js pages) pre-filling src with a 1x1 transparent
        # placeholder (a data: URI) that only gets swapped for the real
        # photo by an IntersectionObserver once the image scrolls into
        # view. fetch_via_chrome.py now scrolls the page first specifically
        # so that swap has already happened by the time we get here, but
        # treat a placeholder src the same as a missing one as a backstop -
        # in case a site's lazy-load only fires on hover/click/a timer
        # rather than on scroll, or Chrome fetching isn't configured at all
        # (remove_javascript = True means the JS never runs in that case).
        for img in soup.find_all("img"):
            src = (img.get("src") or "").strip()
            is_placeholder = (not src) or src.startswith("data:")
            if not is_placeholder:
                continue
            for attr in ("data-src", "data-original", "data-lazy-src", "data-srcset"):
                value = img.get(attr)
                if value:
                    img["src"] = value.split()[0]
                    break

        for img in soup.find_all("img")[self.MAX_IMAGES_PER_ARTICLE:]:
            img.decompose()

        # Readability keeps whatever sits structurally next to the real
        # article body, which on some sites is a trailing wire-service
        # byline stub, not article text - confirmed directly on a real
        # Kicker article: the genuine text ends cleanly, then two separate
        # one-word blocks ("pab", "DPA" - reporter initials and agency
        # credit) follow, each in its own <div class="page">. Kindle's own
        # page-splitter treats each of those divs as a page break, so a
        # reader flipping past the real article lands on a screen that's
        # just "DPA" and nothing else - reads exactly like a broken/empty
        # article even though the real content upstream was fine. A
        # trailing block this short (a byline is a few words at most) is
        # never the article itself, so it's safe to drop generically
        # rather than special-casing Kicker's markup by name.
        MAX_TRAILING_JUNK_CHARS = 20
        content_blocks = soup.find_all(["div", "p"], recursive=True)
        for block in reversed(content_blocks):
            if not block.parent:
                continue  # already removed as part of an ancestor block
            if block.find(["img", "a"]):
                break  # a real (if short) figure caption/credit link, not junk
            text = block.get_text(strip=True)
            # Empty text doesn't break the walk - it's a wrapper div left
            # behind by decomposing its one junk child (e.g. the outer
            # <div> that held both "pab" and "DPA" above), safe to clear
            # too so it doesn't linger as a stray empty block.
            if text and len(text) > MAX_TRAILING_JUNK_CHARS:
                break
            block.decompose()

        # The Athletic's articles are hosted on nytimes.com and some embed
        # NYT Games' "Connections: Sports Edition" cross-promo widget
        # directly in the article body - confirmed directly: it pulled in
        # a heading, two teaser lines and the game's own logo image as if
        # they were part of the article, leaving the real article's photo
        # crowded out by a promo. Matched by its own branded heading text,
        # which is far more stable than any CSS class name here.
        for heading in soup.find_all(string=re.compile(r"^\s*Connections:\s*Sports Edition\s*$")):
            container = heading.parent
            # Walk up to the block-level ancestor that holds the whole
            # widget (heading + teaser text + logo), not just the heading's
            # own tag, so the teaser lines and image go with it.
            while container and container.name not in ("div", "section", "aside") and container.parent:
                container = container.parent
            if container and container.name in ("div", "section", "aside"):
                container.decompose()

        return soup

    # A downloaded Handelsblatt article had 8 <img> tags but only 1 real
    # photo (800x533) - the rest were a 1x1 tracking pixel and 240x135
    # "related articles" thumbnails Readability didn't exclude. The HTML
    # markup gives no reliable signal to filter these by (no width/height
    # left after remove_attributes strips them, and Handelsblatt's own
    # class names aren't consistent enough to key off). Filter by the
    # actual downloaded pixel dimensions instead - this is the one point
    # in the pipeline where real dimensions are known for certain.
    MIN_IMAGE_DIMENSION = 150  # px, in width or height

    def preprocess_image(self, img_data, image_url):
        # The Economist illustrates articles with SVG charts/graphics (an
        # <img src="....svg"> reference, confirmed on a real build) - Kindle's
        # reflowable EPUB format generally can't render SVG at all, so it
        # was shipping as an embedded file that just never displayed. PIL
        # can't decode SVG either, so without this it silently fell through
        # the dimension check below as "can't tell, don't block".
        if (image_url or "").lower().endswith(".svg") or img_data[:5] == b"<?xml" or b"<svg" in img_data[:200]:
            return None
        try:
            from PIL import Image
            import io
            width, height = Image.open(io.BytesIO(img_data)).size
            if width < self.MIN_IMAGE_DIMENSION or height < self.MIN_IMAGE_DIMENSION:
                return None
        except Exception:
            pass  # can't tell -> don't block a possibly-legitimate image over it
        return img_data

    # -- selection ----------------------------------------------------------

    # Continuously-updating pages, not static articles: dozens of small
    # entries (each often with its own avatar/logo image), no coherent
    # single read, and a poor fit for a point-in-time Kindle brief. Seen
    # independently from both Guardian (liveblog) and Sportschau
    # (Liveticker) candidates - one Sportschau live-ticker page alone
    # carried 117 <img> tags in a real build.
    LIVE_BLOG_MARKERS = (
        "liveblog", "live-blog", "liveticker", "live-ticker", "live-updates",
        # German broadcast/ticker phrasing (e.g. "... live im Ersten")
        "live im ersten", "live im zdf", "livestream", "live-stream",
    )

    def is_live_blog(self, feed, article):
        haystack = " ".join((self.article_url(article), article.title or "")).lower()
        return any(marker in haystack for marker in self.LIVE_BLOG_MARKERS)

    def parse_feeds(self):
        feeds = super().parse_feeds()

        guardian_feed = self.fetch_guardian_candidates()
        if guardian_feed and guardian_feed.articles:
            feeds.append(guardian_feed)

        for feed in feeds:
            feed.articles = [a for a in feed.articles if not self.is_live_blog(feed, a)]

        history = self.load_history()
        if history:
            skipped = 0
            for feed in feeds:
                fresh = []
                for article in feed.articles:
                    if self.article_url(article) in history:
                        skipped += 1
                    else:
                        fresh.append(article)
                feed.articles = fresh
            self.log("Skipped %d article(s) delivered in the last %d days."
                     % (skipped, SENT_WINDOW_DAYS))

        candidates = []
        for feed in feeds:
            for article in feed.articles:
                candidates.append((feed, article))

        if not candidates:
            self.log.warn("No candidate articles found in any feed.")
            return feeds

        self.log("Collected %d candidate articles." % len(candidates))

        keep_ids = self.select_articles(candidates)

        if keep_ids is None:
            self.log.warn("Falling back to the first %d articles per feed."
                          % FALLBACK_PER_FEED)
            for feed in feeds:
                feed.articles = feed.articles[:FALLBACK_PER_FEED]
        else:
            for index, (feed, article) in enumerate(candidates):
                if index not in keep_ids:
                    feed.articles = [a for a in feed.articles if a is not article]

        self.drop_unreadable_articles(feeds)

        surviving = [f for f in feeds if f.articles]
        total = sum(len(f.articles) for f in surviving)
        self.log("Brief contains %d articles across %d sections."
                 % (total, len(surviving)))

        for feed in surviving:
            for article in feed.articles:
                self.log("  keep: [%s] %s" % (feed.title, article.title))

        self.save_history(history, surviving)
        # download() mutates these same Feed/Article objects in place as
        # articles finish downloading (setting .downloaded, rewriting .url
        # to the local file path) - stash the reference so cleanup() can
        # see the *finished* state once that's happened. See cleanup() for
        # why this can't be done in feeds2index() itself.
        self._final_feeds = surviving
        return surviving

    def select_articles(self, candidates):
        """Return a set of indices to keep, or None to trigger the fallback."""
        api_key = os.environ.get("ANTHROPIC_API_KEY", "").strip()
        if not api_key:
            self.log.warn("ANTHROPIC_API_KEY is not set.")
            return None

        # Claude previously never saw a publish date or the current time at
        # all - just title + summary - so it had no way to judge freshness.
        # Confirmed as the cause of a real complaint: a 2-day-old "upcoming
        # iPhone launch" preview got selected for a brief delivered the day
        # *after* that launch already happened.
        now = datetime.datetime.now(datetime.timezone.utc)
        lines = []
        for index, (feed, article) in enumerate(candidates):
            summary = (getattr(article, "summary", "") or "").strip()
            summary = " ".join(summary.split())[:240]
            age = ""
            utctime = getattr(article, "utctime", None)
            if utctime is not None:
                hours_old = (now - utctime).total_seconds() / 3600
                age = " (%.0fh old)" % hours_old
            lines.append(
                "%d | %s | %s%s%s"
                % (index, feed.title, article.title, age,
                   " -- " + summary if summary else "")
            )

        prompt = (
            "READER PROFILE\n%s\n\n"
            "It is currently %s.\n"
            "Select at most %d articles. Each candidate's age is in "
            "parentheses. Strongly prefer the freshest candidate on a given "
            "story - never select one about an event that has, by its age, "
            "likely already happened or already been superseded by a newer "
            "development (e.g. a 2-day-old \"X will happen tomorrow\" "
            "preview once X has probably already occurred). The exception "
            "is genuine background/long-read pieces, which are timeless by "
            "design and where a candidate's age is not a mark against it.\n\n"
            "CANDIDATES\n%s"
            % (READER_PROFILE.strip(), now.strftime("%A, %Y-%m-%d %H:%M UTC"),
               MAX_ARTICLES, "\n".join(lines))
        )

        try:
            raw = self.call_claude(api_key, prompt)
        except Exception as err:
            self.log.error("Claude selection failed: %s" % err)
            return None

        try:
            cleaned = raw.strip().strip("`")
            if cleaned.lower().startswith("json"):
                cleaned = cleaned[4:]
            keep = json.loads(cleaned)["keep"]
        except Exception as err:
            self.log.error("Could not parse selection response: %s" % err)
            self.log.error("Raw response was: %r" % raw)
            return None

        # Preserve Claude's priority order (its rules ask for "most
        # important first") so the per-source cap below keeps each
        # source's best picks, not an arbitrary subset.
        ordered_ids = []
        seen = set()
        for i in keep:
            try:
                i = int(i)
            except (TypeError, ValueError):
                continue
            if 0 <= i < len(candidates) and i not in seen:
                ordered_ids.append(i)
                seen.add(i)

        if not ordered_ids:
            self.log.warn("Claude selected nothing.")
            return None

        # Enforce each source's slot maximum in code rather than trusting
        # the prompt alone.
        per_source_count = {}
        final_ids = []
        for i in ordered_ids:
            feed, _article = candidates[i]
            source = self.source_name(feed.title)
            limit = SOURCE_SLOT_LIMITS.get(source)
            count = per_source_count.get(source, 0)
            if limit is not None and count >= limit:
                continue
            per_source_count[source] = count + 1
            final_ids.append(i)
            if len(final_ids) >= MAX_ARTICLES:
                break

        return set(final_ids)

    @staticmethod
    def source_name(feed_title):
        return feed_title.split(" - ", 1)[0]

    def call_claude(self, api_key, prompt):
        body = json.dumps({
            "model": CLAUDE_MODEL,
            # claude-sonnet-5 reasons before answering; 1024 tokens was
            # entirely consumed by the (invisible) thinking block, leaving
            # nothing for the actual JSON reply. Give it headroom.
            "max_tokens": 4096,
            "system": SELECTION_SYSTEM_PROMPT,
            "messages": [{"role": "user", "content": prompt}],
        }).encode("utf-8")

        request = urllib.request.Request(
            "https://api.anthropic.com/v1/messages",
            data=body,
            headers={
                "content-type": "application/json",
                "x-api-key": api_key,
                "anthropic-version": "2023-06-01",
            },
            method="POST",
        )

        try:
            with urllib.request.urlopen(request, timeout=120) as response:
                payload = json.load(response)
        except urllib.error.HTTPError as err:
            raise RuntimeError(
                "HTTP %s: %s"
                % (err.code, err.read().decode("utf-8", "replace")[:500])
            )

        text = "".join(
            block.get("text", "")
            for block in payload.get("content", [])
            if block.get("type") == "text"
        )
        if not text:
            self.log.error(
                "Claude returned no text content. stop_reason=%r content=%r"
                % (payload.get("stop_reason"), payload.get("content"))
            )
        return text

    # -- quality gate ---------------------------------------------------

    def looks_broken(self, url, raw_html):
        """True if this doesn't look like a real, readable article.

        Checked against the raw fetched page. Calling calibre's own
        readability extractor a second time here (outside the single-shot
        context it's normally used in) turned out to be unreliable - it
        false-positived on a manually re-verified, fully free ZEIT
        article - so this deliberately stays a cheap heuristic: a short
        raw page is a reliable "this is a stub/block page" signal, and
        genuine paywalls are caught by name below rather than by length,
        since the surrounding nav/footer chrome pads a raw page past any
        length threshold regardless of how little article text it holds.
        """
        if not raw_html:
            return True
        text = re.sub(r"<[^>]+>", " ", raw_html)
        text = re.sub(r"\s+", " ", text).strip().lower()
        if len(text) < MIN_ARTICLE_CHARS:
            return True
        return any(marker in text for marker in BROKEN_CONTENT_MARKERS)

    def drop_unreadable_articles(self, feeds):
        """Fetch each surviving candidate once up front and drop the ones
        that come back as a bot-block or paywall page instead of an
        article, so we never ship a "please enable JS" stub - or a
        one-paragraph paywall teaser - to the Kindle.
        """
        for feed in feeds:
            keep = []
            for article in feed.articles:
                url = self.article_url(article)
                if not url:
                    keep.append(article)
                    continue
                try:
                    raw = self.fetch_raw_html(url)
                except Exception as err:
                    # NOTE: this used to keep the article on a fetch
                    # failure, on the theory that "couldn't check" shouldn't
                    # block a possibly-fine article. That was fine when
                    # Chrome fetch failures were rare and per-article, but a
                    # real build showed the actual failure mode: the
                    # persistent Chrome window had zero open tabs, which
                    # broke *every* fetch identically for the whole run -
                    # and every one of those got shipped anyway, sight
                    # unseen, since preprocess_raw_html's own fallback is
                    # Calibre's plain fetcher, which is exactly what's
                    # blocked for NYT/Economist and unreliable everywhere
                    # else (the entire reason Chrome fetching exists). When
                    # a source needs Chrome fetching and Chrome fetching
                    # just failed, dropping is the safe default - shipping
                    # unverified content to the Kindle is worse than a
                    # thinner brief. Only still keep-on-failure when Chrome
                    # fetching isn't configured at all, where this has
                    # always meant "Calibre's own fetch had a hiccup".
                    if self.needs_chrome_fetch(url):
                        self.log.warn(
                            "Dropping (Chrome fetch failed, can't verify): "
                            "[%s] %s (%s): %s"
                            % (feed.title, article.title, url, err)
                        )
                        continue
                    self.log.warn("Quality check could not fetch %s: %s" % (url, err))
                    keep.append(article)
                    continue
                if self.looks_broken(url, raw):
                    self.log.warn(
                        "Dropping unreadable article: [%s] %s (%s)"
                        % (feed.title, article.title, url)
                    )
                else:
                    keep.append(article)
            feed.articles = keep

    # -- sent-article history ----------------------------------------------

    @staticmethod
    def article_url(article):
        return getattr(article, "url", None) or getattr(article, "link", "") or ""

    def load_history(self):
        if not SENT_URLS_FILE or not os.path.exists(SENT_URLS_FILE):
            return {}
        try:
            with open(SENT_URLS_FILE, "r", encoding="utf-8") as handle:
                history = json.load(handle)
        except Exception as err:
            self.log.warn("Could not read %s: %s" % (SENT_URLS_FILE, err))
            return {}

        cutoff = datetime.date.today() - datetime.timedelta(days=SENT_WINDOW_DAYS)
        pruned = {}
        for url, stamp in history.items():
            try:
                if datetime.date.fromisoformat(stamp) >= cutoff:
                    pruned[url] = stamp
            except Exception:
                continue
        return pruned

    def save_history(self, history, feeds):
        if not SENT_URLS_FILE:
            return
        today = datetime.date.today().isoformat()
        for feed in feeds:
            for article in feed.articles:
                url = self.article_url(article)
                if url:
                    history[url] = today
        try:
            directory = os.path.dirname(SENT_URLS_FILE)
            if directory:
                os.makedirs(directory, exist_ok=True)
            with open(SENT_URLS_FILE, "w", encoding="utf-8") as handle:
                json.dump(history, handle, indent=1, sort_keys=True)
        except Exception as err:
            self.log.warn("Could not write %s: %s" % (SENT_URLS_FILE, err))

    # -- front page -------------------------------------------------------

    def cleanup(self):
        """Calibre's own front page always links a feed name to that
        feed's own one-article-listing index page (feed_N/index.html) -
        confirmed straight from calibre's template source, not a
        recipe-level setting - which is a pointless extra click for a feed
        that only has a single article, and several sources here often do
        (Economist/Guardian/Sportschau all landed on 1 some days). Rewrite
        the already-generated front page so those link straight to the
        article instead. Feeds with more than one article keep the normal
        section-index page, since that's still useful there.

        This has to happen here, in cleanup() ("called after all articles
        have been downloaded" - the one hook documented to run at the
        right time), not by overriding feeds2index() directly: confirmed
        straight in calibre's own download() that feeds2index() runs
        *before* the article-download loop even starts, so
        article.downloaded is always still False and article.url is still
        the original web URL, not yet the local file path - the very
        first version of this fix looked correct but silently never
        rewrote a single link, which is how this was caught.
        """
        feeds = getattr(self, "_final_feeds", None)
        if not feeds:
            return
        index_path = os.path.join(self.output_dir, "index.html")
        try:
            with open(index_path, "r", encoding="utf-8") as handle:
                html = handle.read()
        except Exception as err:
            self.log.warn("Could not read %s to rewrite front-page links: %s" % (index_path, err))
            return

        changed = False
        for i, feed in enumerate(feeds):
            downloaded = [a for a in feed.articles if getattr(a, "downloaded", False)]
            if len(downloaded) != 1:
                continue
            # article.url is calibre's own post-download rewrite to the
            # local file path relative to feed_N/ (confirmed directly in
            # calibre's FeedTemplate, which links articles the same way).
            target = "feed_%d/%s" % (i, downloaded[0].url)
            pattern = r'(<li id="feed_%d"[^>]*>\s*<a href=")feed_%d/[^"]*(")' % (i, i)
            html, count = re.subn(pattern, lambda m: m.group(1) + target + m.group(2), html, count=1)
            if count:
                changed = True
            else:
                self.log.warn("Could not rewrite front-page link for feed_%d (%s)" % (i, feed.title))

        if changed:
            try:
                with open(index_path, "w", encoding="utf-8") as handle:
                    handle.write(html)
            except Exception as err:
                self.log.warn("Could not write rewritten front page: %s" % err)

        self.strip_calibre_attribution()

    # Calibre appends a standard "This article was downloaded by calibre
    # from <url>" line to the bottom of every single article, regardless of
    # which fetcher actually supplied the content - confirmed directly
    # against a healthy, full-length Tagesspiegel article carrying this
    # exact line. It's not a signal that Chrome fetching was skipped, but
    # it reads that way, so it's worth stripping.
    #
    # This first attempted a postprocess_html(self, soup, first_fetch)
    # override, which looked like the right public hook - but a direct
    # local test (adding a debug self.log.warn inside it and checking
    # whether "downloaded by" was already in the soup at that point) proved
    # it fires *before* calibre inserts this navbar, not after, for this
    # calibre version - contrary to what a source-reading pass suggested.
    # Stripping only works once the navbar actually exists, i.e. in
    # cleanup() over the finished on-disk files, the same place the
    # front-page link rewrite above already has to happen for the same
    # "runs after everything is really done" reason.
    ATTRIBUTION_RE = re.compile(
        r"<p\b[^>]*>\s*This article was downloaded by\b.*?</p>",
        re.IGNORECASE | re.DOTALL,
    )

    def strip_calibre_attribution(self):
        removed = 0
        for root, _dirs, files in os.walk(self.output_dir):
            for name in files:
                if not name.endswith((".html", ".xhtml")):
                    continue
                path = os.path.join(root, name)
                try:
                    with open(path, "r", encoding="utf-8") as handle:
                        html = handle.read()
                except Exception as err:
                    self.log.warn("Could not read %s: %s" % (path, err))
                    continue
                new_html, count = self.ATTRIBUTION_RE.subn("", html)
                if not count:
                    continue
                try:
                    with open(path, "w", encoding="utf-8") as handle:
                        handle.write(new_html)
                    removed += count
                except Exception as err:
                    self.log.warn("Could not write %s: %s" % (path, err))
        if removed:
            self.log("Stripped calibre's own attribution footer from %d file(s)." % removed)
