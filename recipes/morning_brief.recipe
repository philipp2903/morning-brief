#!/usr/bin/env python
# Morning Brief - a curated daily digest for Kindle.
#
# Pulls headlines from The Economist, NYT, The Guardian, Handelsblatt, ZEIT,
# Tagesspiegel, Sportschau, ESPN, The Athletic and Quanta, asks Claude to fill each
# source's quota (see READER_PROFILE) with its best available pieces,
# downloads only those, and binds them into one periodical.

import calendar
import datetime
import json
import os
import re
import subprocess
import time
import urllib.error
import urllib.parse
import urllib.request

from calibre.web.feeds import Feed
from calibre.web.feeds.news import BasicNewsRecipe

# ---------------------------------------------------------------------------
# CONFIGURATION
# ---------------------------------------------------------------------------

# What "relevant" means. Edit freely - this is the steering wheel.
READER_PROFILE = """
Berlin-based founder and consultant. Runs a small consulting practice focused
on AI adoption and operating cadence in enterprises, with clients in Germany
and internationally. Reads The Economist regularly and wants analysis over
recap: pieces that explain a mechanism or a consequence, not just report a
number or an event.

The brief draws from ten sources, each with a fixed role and a maximum
slot count. Fill each source's slots with its best available pieces for
that role - it is fine to come in under a source's maximum on a slow day,
but do not pad a weak slot, and do not give one source more than its
stated maximum even if another source is short that day.

1. THE ECONOMIST - up to 5 slots. International economics and business
   analysis: this is the exact voice and altitude the rest of the brief is
   calibrated against, so hold every other source's "analysis over recap"
   pieces to this bar.

2. THE NEW YORK TIMES - up to 5 slots. US politics and business; foreign
   affairs the US is driving. Prefer consequence over process: what a
   decision changes, not who said what about it.

3. THE GUARDIAN - up to 5 slots. International business and foreign
   affairs, especially stories not already well covered by the NYT picks.

4. HANDELSBLATT - up to 5 slots. German politics and business: the
   German-language analytical spine of the brief.

5. ZEIT - up to 5 slots. Background and long reads: essays, reported
   features, analysis worth twenty minutes. These need not be from today.

6. TAGESSPIEGEL - up to 5 slots. Berlin: city politics, transport, housing,
   schools, and anything affecting Treptow-Koepenick and Friedrichshagen
   specifically.

7. SPORTSCHAU - up to 5 slots. German sport, especially football and the
   Bundesliga. Only when the story is genuinely interesting: a manager
   sacked, a club in financial trouble, a title race turning, a notable
   transfer. Never routine match reports, tables or fixture previews.

8. ESPN - up to 5 slots. US sport (NFL, NBA, MLB) quick news: scores,
   trades, injuries when they actually matter. Same bar as Sportschau:
   genuinely interesting, not routine game recaps or previews.

9. THE ATHLETIC - up to 5 slots. US sport (NFL, NBA, MLB), in-depth:
   analysis and reported features, the sport-desk equivalent of the
   long-read bar ZEIT is held to elsewhere in this brief. Prefer this
   over ESPN when a story has real depth to it.

10. QUANTA MAGAZINE - up to 2 slots. Properly substantial science or
    mathematics background reads.

Never select two articles covering the same story from different outlets -
prefer whichever single piece explains it best.

Not wanted at all: celebrity and royals, lifestyle and wellness, horoscopes,
listicles, crime reporting without wider significance, and repeat coverage
of a story already carried on a previous day.
"""

# Sum of the per-source maximums above (5+5+5+5+5+5+5+5+5+2).
MAX_ARTICLES = 47

# Enforced in code as a hard cap after Claude's selection, not just left to
# the prompt - keys must match the "<Source> - <Section>" feed-title prefix
# used in `feeds` below.
SOURCE_SLOT_LIMITS = {
    "Economist": 5,
    "NYT": 5,
    "Guardian": 5,
    "Handelsblatt": 5,
    "ZEIT": 5,
    "Tagesspiegel": 5,
    "Sportschau": 5,
    "ESPN": 5,
    "Athletic": 5,
    "Quanta": 2,
}

# If Claude cannot be reached, keep this many articles per feed instead.
# Low, because there are now ~5 feeds per source - the fallback is a rough
# "something is better than nothing" safety net, not a curated substitute.
FALLBACK_PER_FEED = 1

# Sonnet gives better editorial judgement; swap to
# "claude-haiku-4-5-20251001" if you want it cheaper still.
CLAUDE_MODEL = os.environ.get("CLAUDE_MODEL", "claude-sonnet-5")

# Path to the history of already-delivered articles. Optional: leave the
# environment variable unset and the brief simply stops deduplicating.
# Resolved to an absolute path so it lands in the same place regardless of
# what directory calibre's recipe execution happens to run from.
_sent_urls_file = os.environ.get("SENT_URLS_FILE", "")
SENT_URLS_FILE = os.path.abspath(_sent_urls_file) if _sent_urls_file else ""
SENT_WINDOW_DAYS = 14

# Build identifier, stamped into the periodical so a given brief can be
# traced back to the recipe version that produced it. Set by the workflow;
# falls back to something recognisable for local runs.
RECIPE_VERSION = os.environ.get("RECIPE_VERSION", "local-dev").strip() or "local-dev"

# NYT and The Economist both run Cloudflare/DataDome-style bot-detection
# that blocks Calibre's own fetcher - and also blocks a freshly-launched
# automated browser, since Playwright/Selenium set a navigator.webdriver
# flag those vendors check for. Confirmed by testing: attaching to an
# already-running, normally-launched Chrome via CDP does not set that flag
# and gets through to the real page (Economist Espresso's own RSS is also
# Cloudflare-blocked, unlike its regular section feeds - see the feeds list).
# CHROME_FETCH_PYTHON/CHROME_FETCH_SCRIPT point at the venv and script that
# do that; if either is unset, these domains just fall back to Calibre's
# normal (blocked) fetcher. (kicker.de turned out to be behind the same
# kind of wall - Sportschau was used instead rather than fighting it too.)
CHROME_FETCH_DOMAINS = {"www.nytimes.com", "nytimes.com", "www.economist.com", "economist.com"}
CHROME_FETCH_PYTHON = os.environ.get("CHROME_FETCH_PYTHON", "")
CHROME_FETCH_SCRIPT = os.environ.get("CHROME_FETCH_SCRIPT", "")

# Phrases that show up on bot-blocked or paywalled pages instead of real
# article text. If a downloaded article's content matches one of these (or
# is simply too short to be an article), it is dropped rather than shipped.
#
# NOTE: plain "please enable javascript"/"please enable js" used to be here
# and caused real false positives - that exact phrase is standard
# <noscript> boilerplate on nearly every modern JS-framework site (confirmed
# on a genuinely free, manually-verified Handelsblatt article, which is how
# this was caught), not a bot-block signal by itself. Keep markers specific
# enough to actually distinguish a block page from ordinary noscript text.
BROKEN_CONTENT_MARKERS = (
    # NYT/generic DataDome-style block pages actually say "enable JS and
    # disable any ad blocker" - "disable any ad blocker" alone is specific
    # enough to catch it without needing the exact "enable JS" wording too.
    "disable any ad blocker",
    "disable your ad blocker",
    "subscribe to continue reading",
    "you have reached your article limit",
    "access denied",
    "are you a robot",
    "verify you are a human",
    # Tagesspiegel and ZEIT paywalls: the free preview is real but partial,
    # not broken - it still fails the "read the whole thing on Kindle" bar.
    "tagesspiegel plus",
    "abopflichtiger inhalt",
    "jetzt abonnieren",
    # NYT paywall hit when the Chrome session isn't (or is no longer) logged
    # in - same "partial preview, not the whole article" logic.
    "want all of the times? subscribe",
    "log in to continue reading",
)
# Measured against the *extracted* article body (what auto_cleanup would
# actually ship), not the raw page - a raw page is always >500 chars of
# nav/footer/cookie-banner chrome regardless of how little real article
# text it contains, which is how a one-paragraph paywall teaser slipped
# through the first version of this check.
MIN_ARTICLE_CHARS = 500

SELECTION_SYSTEM_PROMPT = """You are the editor of a personal morning \
newspaper. You are given today's candidate articles (each labelled with its \
source) and a profile of the single reader that states each source's role \
and maximum slot count. Fill each source's slots with its best available \
candidates for that source's stated role.

Rules:
- Each source's slot count is a MAXIMUM, not a target: it is fine to use
  fewer of a source's slots on a slow day, but never more than its stated
  maximum, and never reassign one source's unused slots to another source.
- Favour substance over volume. Prefer one strong analysis over three thin
  updates on the same event.
- Never select two articles covering the same story from different outlets.
- Answer with JSON only, no prose and no code fences, in exactly this shape:
  {"keep": [3, 11, 24]}
  where the numbers are the candidate ids you are keeping, most important
  first."""


class MorningBrief(BasicNewsRecipe):
    title = "Morning Brief"
    description = (
        "A curated selection from The Economist, NYT, The Guardian, "
        "Handelsblatt, ZEIT, Tagesspiegel, Sportschau, ESPN, The Athletic "
        "and Quanta"
    )
    __author__ = "Philipp Schett"
    publication_type = "newspaper"
    language = "de"
    encoding = "utf-8"

    # Two days rather than one, so that long reads published yesterday
    # afternoon are still eligible. The sent-article history below stops the
    # wider window causing repeats.
    oldest_article = 2
    max_articles_per_feed = 20

    # NYT returns 403 Forbidden to plain HTTP fetches of article pages (RSS
    # itself is unaffected). Use the QtWebEngine-based fetcher instead of
    # calibre's default mechanize one to get past that.
    browser_type = "webengine"

    no_stylesheets = True
    remove_javascript = True
    use_embedded_content = False
    # 47 possible articles across 10 sources with real embedded photos adds
    # up fast (one earlier 22-article build was already ~19MB) - Send to
    # Kindle's own limits (50MB email, and a documented tendency to fail
    # server-side conversion on large/complex files with a generic E999
    # error) make it worth capping images rather than shipping them at
    # full source resolution.
    compress_news_images = True
    compress_news_images_max_size = 60  # KB
    scale_news_images = (800, 800)
    auto_cleanup = True
    # auto_cleanup's readability scoring only keeps what it judges to be
    # the main text flow, which drops hero/lead images since they sit
    # outside the paragraph flow. Force those specific containers to
    # survive: ZEIT's lead-image wrapper, Tagesspiegel's header (byline +
    # image, per calibre's own upstream tagesspiegel.recipe), and any
    # <figure> generally.
    # ZEIT uses more than one article template with different hero-image
    # wrapper classes (verified live: "article__media-container" on a news
    # piece, "header-fullwidth__media-container" on a column/feature piece)
    # but both sit inside the same <header class="article-header">, so key
    # off that rather than the inner class. //picture on its own since
    # ZEIT's fullwidth template uses <picture> without wrapping <figure>.
    auto_cleanup_keep = (
        '//header[contains(@class,"article-header")]'
        '|//header[contains(@class,"Bo")]'
        '|//figure'
        '|//picture'
    )
    remove_empty_feeds = True
    ignore_duplicate_articles = {"title", "url"}
    timefmt = " [%a, %d %B %Y] - " + RECIPE_VERSION

    feeds = [
        # Espresso's own RSS (and the bare /rss) are Cloudflare-blocked even
        # for feed discovery, unlike these regular section feeds - articles
        # from any of these still route through the Chrome CDP fetcher via
        # CHROME_FETCH_DOMAINS for the actual full-text download.
        ("Economist - Finance & Economics", "https://www.economist.com/finance-and-economics/rss.xml"),
        ("Economist - Business", "https://www.economist.com/business/rss.xml"),
        ("NYT - Home", "https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml"),
        ("NYT - Business", "https://rss.nytimes.com/services/xml/rss/nyt/Business.xml"),
        ("NYT - Economy", "https://rss.nytimes.com/services/xml/rss/nyt/Economy.xml"),
        ("NYT - Politics", "https://rss.nytimes.com/services/xml/rss/nyt/Politics.xml"),
        ("NYT - World", "https://rss.nytimes.com/services/xml/rss/nyt/World.xml"),
        ("NYT - Technology", "https://rss.nytimes.com/services/xml/rss/nyt/Technology.xml"),
        ("NYT - Magazine", "https://rss.nytimes.com/services/xml/rss/nyt/Magazine.xml"),
        ("Handelsblatt - Top-Themen", "https://www.handelsblatt.com/contentexport/feed/top-themen"),
        ("Handelsblatt - Politik", "https://www.handelsblatt.com/contentexport/feed/politik"),
        ("Handelsblatt - Unternehmen", "https://www.handelsblatt.com/contentexport/feed/unternehmen"),
        ("Handelsblatt - Finanzen", "https://www.handelsblatt.com/contentexport/feed/finanzen"),
        ("ZEIT - Wirtschaft", "https://newsfeed.zeit.de/wirtschaft/index"),
        ("ZEIT - Politik", "https://newsfeed.zeit.de/politik/index"),
        ("ZEIT - Digital", "https://newsfeed.zeit.de/digital/index"),
        ("ZEIT - Gesellschaft", "https://newsfeed.zeit.de/gesellschaft/index"),
        ("Tagesspiegel - Berlin", "https://www.tagesspiegel.de/contentexport/feed/berlin"),
        ("Tagesspiegel - Home", "https://www.tagesspiegel.de/contentexport/feed/home"),
        ("Sportschau - Alle Sportarten", "https://www.sportschau.de/index~rss2.xml"),
        ("Sportschau - Bundesliga", "https://www.sportschau.de/fussball/bundesliga/index~rss2.xml"),
        ("ESPN - NFL", "https://www.espn.com/espn/rss/nfl/news"),
        ("ESPN - NBA", "https://www.espn.com/espn/rss/nba/news"),
        # theathletic.com's own domain sits behind Cloudflare like FT did;
        # The Athletic is owned by NYT and hosted under nytimes.com/athletic/
        # instead, which is why these use that domain - CHROME_FETCH_DOMAINS
        # already covers it, and the NYT login session doubles as Athletic
        # access (NYT All Access includes it).
        ("Athletic - NFL", "https://www.nytimes.com/athletic/rss/nfl/"),
        ("Athletic - NBA", "https://www.nytimes.com/athletic/rss/nba/"),
        ("Athletic - MLB", "https://www.nytimes.com/athletic/rss/mlb/"),
        ("Quanta - Articles", "https://api.quantamagazine.org/feed/"),
    ]

    def __init__(self, *args, **kwargs):
        BasicNewsRecipe.__init__(self, *args, **kwargs)
        # url -> full article HTML, populated by fetch_guardian_candidates.
        # Guardian's own site has no bot-wall, but their API already hands
        # us the full body in the same call that finds the candidates, so
        # there's no reason to fetch each article a second time over HTTP.
        self._guardian_bodies = {}

    # -- The Guardian (Open Platform API) --------------------------------

    GUARDIAN_SECTIONS = ("world",)

    def fetch_guardian_candidates(self):
        api_key = os.environ.get("GUARDIAN_API_KEY", "").strip()
        if not api_key:
            self.log.warn("GUARDIAN_API_KEY is not set; skipping The Guardian.")
            return None

        from_date = (datetime.date.today() - datetime.timedelta(days=self.oldest_article)).isoformat()
        params = {
            "section": "|".join(self.GUARDIAN_SECTIONS),
            "type": "article",
            "order-by": "newest",
            "show-fields": "trailText,body,byline",
            "page-size": "30",
            "from-date": from_date,
            "api-key": api_key,
        }
        url = "https://content.guardianapis.com/search?" + urllib.parse.urlencode(params)
        try:
            with urllib.request.urlopen(url, timeout=30) as response:
                payload = json.load(response)
        except Exception as err:
            self.log.error("Guardian API request failed: %s" % err)
            return None

        # populate_from_preparsed_feed() is calibre's own hook for exactly
        # this - injecting non-RSS article data - and handles the Feed
        # attributes a hand-built Feed() is easy to get wrong (feed2index()
        # needs image_url/width/height/alt, which a naive Feed() lacks),
        # plus age filtering and dedup, the same as the normal RSS path.
        items = []
        for item in payload.get("response", {}).get("results", []):
            fields = item.get("fields", {})
            body = fields.get("body", "")
            article_url = item.get("webUrl", "")
            if not body or not article_url:
                continue
            try:
                timestamp = calendar.timegm(
                    time.strptime(item.get("webPublicationDate", ""), "%Y-%m-%dT%H:%M:%SZ")
                )
            except ValueError:
                timestamp = time.time()
            self._guardian_bodies[article_url] = "<html><body>%s</body></html>" % body
            items.append({
                "id": item.get("id", article_url),
                "title": item.get("webTitle", ""),
                "url": article_url,
                "author": fields.get("byline", ""),
                "description": fields.get("trailText", ""),
                "content": "",
                "timestamp": timestamp,
            })

        feed = Feed(log=self.log)
        feed.populate_from_preparsed_feed(
            "Guardian - World", items,
            oldest_article=self.oldest_article,
            max_articles_per_feed=self.max_articles_per_feed,
        )
        self.log("Guardian API returned %d candidate articles." % len(feed.articles))
        return feed

    # -- Chrome CDP fetch (NYT) -------------------------------------------

    def needs_chrome_fetch(self, url):
        host = urllib.parse.urlparse(url).netloc
        return host in CHROME_FETCH_DOMAINS and CHROME_FETCH_PYTHON and CHROME_FETCH_SCRIPT

    def fetch_via_chrome(self, url):
        result = subprocess.run(
            [CHROME_FETCH_PYTHON, CHROME_FETCH_SCRIPT, url],
            capture_output=True, timeout=60,
        )
        if result.returncode != 0:
            raise RuntimeError(result.stderr.decode("utf-8", "replace")[:500])
        return result.stdout.decode("utf-8", "replace")

    def fetch_raw_html(self, url):
        """Raw HTML for a URL: Guardian uses the body its API already
        handed us, NYT routes through the real-Chrome fetcher, and
        everything else goes through Calibre's normal fetcher."""
        if url in self._guardian_bodies:
            return self._guardian_bodies[url]
        if self.needs_chrome_fetch(url):
            return self.fetch_via_chrome(url)
        raw = self.index_to_soup(url, raw=True)
        if isinstance(raw, bytes):
            raw = raw.decode("utf-8", "replace")
        return raw

    def preprocess_raw_html(self, raw_html, url):
        if url in self._guardian_bodies:
            return self._guardian_bodies[url]
        # Calibre's own webengine fetch already ran and got blocked by the
        # time this hook fires; for NYT, throw that away and re-fetch
        # through the real-Chrome path instead.
        if self.needs_chrome_fetch(url):
            try:
                return self.fetch_via_chrome(url)
            except Exception as err:
                self.log.warn("Chrome CDP fetch failed for %s: %s" % (url, err))
        return raw_html

    # -- images ---------------------------------------------------------

    def preprocess_html(self, soup):
        # Some sites lazy-load images via data-src/data-original and leave
        # src empty until JS runs. remove_javascript = True means that JS
        # never runs, so without this the image is simply missing.
        for img in soup.find_all("img"):
            if img.get("src"):
                continue
            for attr in ("data-src", "data-original", "data-lazy-src", "data-srcset"):
                value = img.get(attr)
                if value:
                    img["src"] = value.split()[0]
                    break
        return soup

    # -- selection ----------------------------------------------------------

    def parse_feeds(self):
        feeds = super().parse_feeds()

        guardian_feed = self.fetch_guardian_candidates()
        if guardian_feed and guardian_feed.articles:
            feeds.append(guardian_feed)

        history = self.load_history()
        if history:
            skipped = 0
            for feed in feeds:
                fresh = []
                for article in feed.articles:
                    if self.article_url(article) in history:
                        skipped += 1
                    else:
                        fresh.append(article)
                feed.articles = fresh
            self.log("Skipped %d article(s) delivered in the last %d days."
                     % (skipped, SENT_WINDOW_DAYS))

        candidates = []
        for feed in feeds:
            for article in feed.articles:
                candidates.append((feed, article))

        if not candidates:
            self.log.warn("No candidate articles found in any feed.")
            return feeds

        self.log("Collected %d candidate articles." % len(candidates))

        keep_ids = self.select_articles(candidates)

        if keep_ids is None:
            self.log.warn("Falling back to the first %d articles per feed."
                          % FALLBACK_PER_FEED)
            for feed in feeds:
                feed.articles = feed.articles[:FALLBACK_PER_FEED]
        else:
            for index, (feed, article) in enumerate(candidates):
                if index not in keep_ids:
                    feed.articles = [a for a in feed.articles if a is not article]

        self.drop_unreadable_articles(feeds)

        surviving = [f for f in feeds if f.articles]
        total = sum(len(f.articles) for f in surviving)
        self.log("Brief contains %d articles across %d sections."
                 % (total, len(surviving)))

        for feed in surviving:
            for article in feed.articles:
                self.log("  keep: [%s] %s" % (feed.title, article.title))

        self.save_history(history, surviving)
        return surviving

    def select_articles(self, candidates):
        """Return a set of indices to keep, or None to trigger the fallback."""
        api_key = os.environ.get("ANTHROPIC_API_KEY", "").strip()
        if not api_key:
            self.log.warn("ANTHROPIC_API_KEY is not set.")
            return None

        lines = []
        for index, (feed, article) in enumerate(candidates):
            summary = (getattr(article, "summary", "") or "").strip()
            summary = " ".join(summary.split())[:240]
            lines.append(
                "%d | %s | %s%s"
                % (index, feed.title, article.title,
                   " -- " + summary if summary else "")
            )

        prompt = (
            "READER PROFILE\n%s\n\n"
            "Select at most %d articles.\n\n"
            "CANDIDATES\n%s"
            % (READER_PROFILE.strip(), MAX_ARTICLES, "\n".join(lines))
        )

        try:
            raw = self.call_claude(api_key, prompt)
        except Exception as err:
            self.log.error("Claude selection failed: %s" % err)
            return None

        try:
            cleaned = raw.strip().strip("`")
            if cleaned.lower().startswith("json"):
                cleaned = cleaned[4:]
            keep = json.loads(cleaned)["keep"]
        except Exception as err:
            self.log.error("Could not parse selection response: %s" % err)
            self.log.error("Raw response was: %r" % raw)
            return None

        # Preserve Claude's priority order (its rules ask for "most
        # important first") so the per-source cap below keeps each
        # source's best picks, not an arbitrary subset.
        ordered_ids = []
        seen = set()
        for i in keep:
            try:
                i = int(i)
            except (TypeError, ValueError):
                continue
            if 0 <= i < len(candidates) and i not in seen:
                ordered_ids.append(i)
                seen.add(i)

        if not ordered_ids:
            self.log.warn("Claude selected nothing.")
            return None

        # Enforce each source's slot maximum in code rather than trusting
        # the prompt alone.
        per_source_count = {}
        final_ids = []
        for i in ordered_ids:
            feed, _article = candidates[i]
            source = self.source_name(feed.title)
            limit = SOURCE_SLOT_LIMITS.get(source)
            count = per_source_count.get(source, 0)
            if limit is not None and count >= limit:
                continue
            per_source_count[source] = count + 1
            final_ids.append(i)
            if len(final_ids) >= MAX_ARTICLES:
                break

        return set(final_ids)

    @staticmethod
    def source_name(feed_title):
        return feed_title.split(" - ", 1)[0]

    def call_claude(self, api_key, prompt):
        body = json.dumps({
            "model": CLAUDE_MODEL,
            # claude-sonnet-5 reasons before answering; 1024 tokens was
            # entirely consumed by the (invisible) thinking block, leaving
            # nothing for the actual JSON reply. Give it headroom.
            "max_tokens": 4096,
            "system": SELECTION_SYSTEM_PROMPT,
            "messages": [{"role": "user", "content": prompt}],
        }).encode("utf-8")

        request = urllib.request.Request(
            "https://api.anthropic.com/v1/messages",
            data=body,
            headers={
                "content-type": "application/json",
                "x-api-key": api_key,
                "anthropic-version": "2023-06-01",
            },
            method="POST",
        )

        try:
            with urllib.request.urlopen(request, timeout=120) as response:
                payload = json.load(response)
        except urllib.error.HTTPError as err:
            raise RuntimeError(
                "HTTP %s: %s"
                % (err.code, err.read().decode("utf-8", "replace")[:500])
            )

        text = "".join(
            block.get("text", "")
            for block in payload.get("content", [])
            if block.get("type") == "text"
        )
        if not text:
            self.log.error(
                "Claude returned no text content. stop_reason=%r content=%r"
                % (payload.get("stop_reason"), payload.get("content"))
            )
        return text

    # -- quality gate ---------------------------------------------------

    def looks_broken(self, url, raw_html):
        """True if this doesn't look like a real, readable article.

        Checked against the raw fetched page. Calling calibre's own
        readability extractor a second time here (outside the single-shot
        context it's normally used in) turned out to be unreliable - it
        false-positived on a manually re-verified, fully free ZEIT
        article - so this deliberately stays a cheap heuristic: a short
        raw page is a reliable "this is a stub/block page" signal, and
        genuine paywalls are caught by name below rather than by length,
        since the surrounding nav/footer chrome pads a raw page past any
        length threshold regardless of how little article text it holds.
        """
        if not raw_html:
            return True
        text = re.sub(r"<[^>]+>", " ", raw_html)
        text = re.sub(r"\s+", " ", text).strip().lower()
        if len(text) < MIN_ARTICLE_CHARS:
            return True
        return any(marker in text for marker in BROKEN_CONTENT_MARKERS)

    def drop_unreadable_articles(self, feeds):
        """Fetch each surviving candidate once up front and drop the ones
        that come back as a bot-block or paywall page instead of an
        article, so we never ship a "please enable JS" stub - or a
        one-paragraph paywall teaser - to the Kindle.
        """
        for feed in feeds:
            keep = []
            for article in feed.articles:
                url = self.article_url(article)
                if not url:
                    keep.append(article)
                    continue
                try:
                    raw = self.fetch_raw_html(url)
                except Exception as err:
                    self.log.warn("Quality check could not fetch %s: %s" % (url, err))
                    keep.append(article)
                    continue
                if self.looks_broken(url, raw):
                    self.log.warn(
                        "Dropping unreadable article: [%s] %s (%s)"
                        % (feed.title, article.title, url)
                    )
                else:
                    keep.append(article)
            feed.articles = keep

    # -- sent-article history ----------------------------------------------

    @staticmethod
    def article_url(article):
        return getattr(article, "url", None) or getattr(article, "link", "") or ""

    def load_history(self):
        if not SENT_URLS_FILE or not os.path.exists(SENT_URLS_FILE):
            return {}
        try:
            with open(SENT_URLS_FILE, "r", encoding="utf-8") as handle:
                history = json.load(handle)
        except Exception as err:
            self.log.warn("Could not read %s: %s" % (SENT_URLS_FILE, err))
            return {}

        cutoff = datetime.date.today() - datetime.timedelta(days=SENT_WINDOW_DAYS)
        pruned = {}
        for url, stamp in history.items():
            try:
                if datetime.date.fromisoformat(stamp) >= cutoff:
                    pruned[url] = stamp
            except Exception:
                continue
        return pruned

    def save_history(self, history, feeds):
        if not SENT_URLS_FILE:
            return
        today = datetime.date.today().isoformat()
        for feed in feeds:
            for article in feed.articles:
                url = self.article_url(article)
                if url:
                    history[url] = today
        try:
            directory = os.path.dirname(SENT_URLS_FILE)
            if directory:
                os.makedirs(directory, exist_ok=True)
            with open(SENT_URLS_FILE, "w", encoding="utf-8") as handle:
                json.dump(history, handle, indent=1, sort_keys=True)
        except Exception as err:
            self.log.warn("Could not write %s: %s" % (SENT_URLS_FILE, err))
